# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
run_logs/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# OS / editor noise
.DS_Store
Thumbs.db
/data

# Training and fetch logs
*.log
run_logs_*.txt

# Model checkpoints. The curated keepers in models/README.md are tracked
# (force-added); everything else under models/ — and all throwaway runs in
# models/scratch/ — is ignored. See models/README.md for the convention.
models/*.pt
models/*.npz
models/*.json

# Regenerable working encoder checkpoints (training artifacts; rewritten every run)
experiments/fingerprints/*_synth*.pt
experiments/fingerprints/*_8nm.pt
experiments/fingerprints/*_depth.pt
experiments/fingerprints/*depth8nm.pt
.v117_cache/
models/scratch/

# Local CAVE synapse fetch cache
syn_cache/

# L2 skeleton / synapse / world cache NPZ files (git-lfs intended but not required;
# cache/README.md is tracked; the NPZ data files are local-only)
cache/**/*.npz

# Agent scratch prototype (contains a token; superseded by neuronauts/bulk_synapses.py)
scratchpad_bulk_synapses.py

# Curated keepers (force-add a new one with `git add -f` and add a manifest row)
!models/README.md
!models/grammar_cave_real_50.pt
!models/grammar_synthetic.pt
!models/shared_grammar_real.pt
!models/shared_grammar_raw_skel_50e.pt
!models/shared_grammar_raw_skel_gat50e.pt
!models/gat_skeleton_50e.pt
!models/shared_grammar_root_neighborhood_run001.pt
!models/cell_gnn_seg.pt
!models/cell_gnn_seg.metrics.json
!models/cell_gnn_5feat.pt
!models/cell_gnn_5feat.metrics.json
!models/cell_gnn_real.pt
!models/cell_gnn_real.metrics.json

# credentials: never commit a token, and never a local secrets copy
.cloudvolume/
secrets/
*cave-secret*.json

# large reference documents: keep locally, not in the tree
docs/*.pdf
